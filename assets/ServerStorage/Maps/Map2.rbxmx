					<Item class="Script" referent="RBXFC2081429E2B4537B6870158114FB0EF">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local hinge = script.Parent.Hinge
local pole = script.Parent.Pole
local base = script.Parent.Base

pole.BodyGyro.cframe = pole.CFrame
base.BodyPosition.Position = base.Position

for i, v in pairs(script.Parent:GetChildren()) do
	if v:IsA("BasePart") and v ~= hinge then
		v.Anchored = false
	end
end]]></ProtectedString>
