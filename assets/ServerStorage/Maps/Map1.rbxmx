				<Item class="Script" referent="RBXF37B6AB053564467A74370042F02B3A4">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Model = script.Parent
local Surface = Model.Surface
local WaterLayer = Model.WaterLayer

repeat
	task.wait(0.1)
	for i=0, 100 do
		Surface.Position += Vector3.new(0, 0.005, 0)
		WaterLayer.Position += Vector3.new(0, 0.01, 0)
		task.wait()
	end
	task.wait()
	for i=0, 100 do
		Surface.Position -= Vector3.new(0, 0.005, 0)
		WaterLayer.Position -= Vector3.new(0, 0.01, 0)
		task.wait()
	end 
until false ]]></ProtectedString>
